{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-capability",
  "description": "Permissions for the desktop workspace window",
  "windows": ["desktop"],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:allow-open",
    "shell:allow-open",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister"
  ]
}
